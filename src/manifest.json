{
  "manifest_version": 3,
  "name": "VoicePilot",
  "version": "1.1.1",
  "icons": {
    "16": "icons/icon16.webp",
    "32": "icons/icon32.webp",
    "48": "icons/icon48.webp",
    "128": "icons/icon128.webp"
  },
  "description": "A conversational accessibility layer for the internet — browse, understand, and navigate websites completely through voice.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VoicePilot Settings",
    "default_icon": {
      "16": "icons/icon16.webp",
      "32": "icons/icon32.webp",
      "48": "icons/icon48.webp",
      "128": "icons/icon128.webp"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/*",
        "overlay.css",
        "constants.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}